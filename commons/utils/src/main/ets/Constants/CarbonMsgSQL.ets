    USE_TIME DOUBLE NOT NULL,
    ELECT_POWER INTEGER,
    TIME_TOKEN TEXT,
    CARBON_EMISSION DOUBLE NOT NULL);`
  }

  static createApplianceTotalSQL(tableName: string) {
    return `CREATE TABLE IF NOT EXISTS ${tableName} (
